{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-routing-template",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "upload_source_maps": true,
  "vars": {
    "ROUTE_ADDRESS": "alerts@crew-ops.dev"
  },
  // No "addresses" here: the human-reviewed rule is managed in the
  // Cloudflare Email Routing UI. Do not automatically reconcile routes.
  "observability": {
    "enabled": true
  }
}
